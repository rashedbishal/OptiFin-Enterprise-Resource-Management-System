APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=optifin_erp
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Real-time broadcasting (Laravel Reverb) — a local-development template.
# The credentials below are LOCAL DEVELOPMENT ONLY placeholders, not production
# credentials. Production deployments MUST use unique, generated credentials —
# never reuse these example values. `php artisan reverb:install` can generate
# proper local configuration, and can be re-run to regenerate/update it.
# `php artisan dev` (composer run dev) already starts the Reverb server.
REVERB_APP_ID=local-dev-app-id
REVERB_APP_KEY=local-dev-key
REVERB_APP_SECRET=local-dev-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Browser (resources/js/echo.js) values. Vite bakes VITE_* into the frontend build,
# so run `npm run build` (or restart `npm run dev`) AFTER these are configured.
# Only the public app key is exposed to the browser — never add a VITE_ copy of
# REVERB_APP_SECRET.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Operational monitoring (see docs/lead-management/OPS-MONITORING.md). Both optional.
# Where scheduler-failure / IMAP-outage alerts are emailed (unset = log only).
OPS_ALERT_EMAIL=
# Dead-man's-switch URL pinged every minute by leads:fetch-emails (unset = no heartbeat).
OPS_SCHEDULER_HEARTBEAT_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=

# Web Push (incoming WhatsApp call notifications when the browser is
# closed/backgrounded). Generate a real keypair per environment with
# `php artisan webpush:vapid` — never reuse these example values or share
# one keypair across environments. VAPID_SUBJECT must be a mailto: address
# or a valid URL (Safari requires it).
VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

VITE_APP_NAME="${APP_NAME}"
